{
	"compilerOptions": {
		"checkJs": true,
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"declaration": true,
		"isolatedModules": true,
		"allowJs": true,
		"types": ["node"]
	},
	"include": ["src/**/*"]
}
